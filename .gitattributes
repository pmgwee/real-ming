# Linux entrypoints and systemd units must remain LF-delimited when checked out
# or packaged on Windows. A CR before the shebang newline makes /usr/bin/env
# look for an executable named `bash\r` on the production host.
deploy/**/*.sh text eol=lf
deploy/systemd/* text eol=lf
hermes/**/*.sh text eol=lf

# Skill frontmatter is parsed by splitting on LF. A CRLF checkout leaves a
# trailing CR on every value, so `name` reads as the name plus a carriage return and no skill
# resolves -- which fails the skill-pack tests on Windows for a file that is
# correct in Git and correct on the Linux host.
hermes/**/*.md text eol=lf
