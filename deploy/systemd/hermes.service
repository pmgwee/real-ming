[Unit]
Description=Hermes Agent API gateway for Real-Ming
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=real-ming
Group=real-ming
WorkingDirectory=/var/lib/hermes-real-ming
Environment=HOME=/var/lib/hermes-real-ming
Environment=HERMES_HOME=/var/lib/hermes-real-ming
Environment=API_SERVER_HOST=127.0.0.1
Environment=API_SERVER_PORT=8642
Environment=OBSIDIAN_VAULT_PATH=/var/lib/hermes-real-ming/obsidian-vault
# Native cron dispatches each run into a restart-safe `systemd-run --user
# --scope`, which needs the user D-Bus. A system service has none by default,
# so the scheduler fired on time and every unattended run failed with
# "systemd-run --user --scope is unavailable" while manual `hermes cron run`
# kept working -- it executes in the CLI's own process instead.
# Requires `loginctl enable-linger real-ming` on the host so /run/user/999
# exists; the host preparation script does that.
Environment=XDG_RUNTIME_DIR=/run/user/999
EnvironmentFile=/etc/real-ming/hermes.env
StateDirectory=hermes-real-ming
StateDirectoryMode=0700
ExecStartPre=/usr/bin/install -d -o real-ming -g real-ming -m 0700 /var/lib/hermes-real-ming/obsidian-vault
ExecStart=/usr/local/bin/hermes gateway run --external-supervisor --quiet
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=true masks /home, /root AND /run/user with an inaccessible empty
# directory, and that mask wins over BindPaths. /run/user is where the user
# D-Bus lives, so with it masked the native cron ticker fires on schedule and
# every unattended run fails to dispatch, while manual `hermes cron run` keeps
# working because it executes in the CLI's own process. Blocking /home and
# /root explicitly keeps the actual intent -- the service account's home is
# /var/lib/hermes-real-ming, not under /home -- without hiding the bus.
ProtectHome=false
InaccessiblePaths=/home /root
# ProtectSystem=strict gives this unit its own mount namespace, and the user
# runtime directory is not in it by default -- /run/user/999 simply does not
# exist inside the service. Setting XDG_RUNTIME_DIR alone is therefore not
# enough: the path has to be admitted too, or `systemd-run --user --scope`
# still cannot reach the user bus and every unattended cron run fails to
# dispatch. The `-` prefix keeps startup working if lingering is ever off.
# The MCP extension opens the Real-Ming state database, which lives outside
# this unit's StateDirectory. ProtectSystem=strict makes every other path
# read-only inside the namespace, so without naming it here the extension dies
# on startup with "attempt to write a readonly database" and the gateway
# registers none of its tools -- while the same binary run outside systemd
# works, which is exactly how this was missed.
ReadWritePaths=/var/lib/hermes-real-ming /var/lib/real-ming
# ProtectHome=true masks /home, /root AND /run/user -- which is exactly where
# the user D-Bus that `systemd-run --user --scope` needs lives. ReadWritePaths
# alone does not undo that masking, so the directory stays invisible inside the
# namespace and every unattended cron run fails to dispatch while manual runs
# keep working. An explicit bind restores just this one path and leaves the rest
# of ProtectHome intact.
BindPaths=/run/user/999

[Install]
WantedBy=multi-user.target
