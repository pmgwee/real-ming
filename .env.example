# Real-Ming local development environment · Architecture Revision 6
#
# Copy to .env and supply each value from the authorized secret store.
# Never commit a filled-in copy; .env and .env.* are ignored by Git.
# Names only live here. Values live only in the secret store.
#
# ---------------------------------------------------------------------------
# THIS FILE IS FOR LOCAL DEVELOPMENT ONLY. Production does not read it.
# ---------------------------------------------------------------------------
#
# The deployed control plane keeps secrets and configuration apart, and this
# file exists only because a local `npm run` has neither of those mechanisms:
#
#   Secrets        Azure Key Vault, resolved at startup through the VM managed
#                  identity. Never written to disk on the host.
#   Configuration  /etc/real-ming/release.env, supplied to the unit by
#                  EnvironmentFile= and passed into the container with explicit
#                  --env flags.
#   This file      Read only by local `npm run` scripts via
#                  --env-file-if-exists. The container has no --env-file at all.
#
# So the two sections below are NOT equivalent, and mixing them in one file is a
# local convenience, not the design. Section 1 is credential material and
# belongs in a secret store. Section 2 is ordinary configuration that could sit
# in version control; it is listed here so a local run works and so no setting
# the code reads is invisible to a reader. A test derives section 2 from the
# composition sources and fails when a name is missing.
#
# One name that is deliberately absent: the Telegram bot token the native
# gateway uses. Under Revision 6 that lives in the HERMES environment
# ($HERMES_HOME/.env as TELEGRAM_BOT_TOKEN / TELEGRAM_ALLOWED_USERS). Setting it
# here would configure the consumer that Revision 6 stopped.

# =============================================================================
# SECTION 1 · SECRETS — credential material, Key Vault in production
# =============================================================================
# The ten below are the required set; the control plane refuses to start
# without them. `npm run secrets:preflight` reports them by name, never by
# value, and a test scans every tracked file for credential-shaped material.
#
# Not every name here is equally sensitive: CEO_ID, MASTER_TASKS_ID and
# CLIENT_ID are identifiers rather than secrets. They live in this section
# because the credential resolver treats the set as one unit.

# Authenticate the Real-Ming Telegram records and the legacy ingress path.
REAL_MING_TELEGRAM_BOT_TOKEN=

# Allowlist the single numeric Telegram identity that may command Real-Ming.
REAL_MING_TELEGRAM_CEO_ID=

# Read and write Master Tasks and the linked Work Views.
REAL_MING_NOTION_TOKEN=

# Identify the canonical Master Tasks data source.
REAL_MING_NOTION_MASTER_TASKS_ID=

# Identify the Google authorization client for Calendar.
REAL_MING_GOOGLE_CLIENT_ID=

# Authorize the Google Calendar client.
REAL_MING_GOOGLE_CLIENT_SECRET=

# Maintain delegated Calendar access without re-consent. The current grant is
# scoped to events only; reading calendar settings would need a new consent.
REAL_MING_GOOGLE_REFRESH_TOKEN=

# Authenticate the CEO to the operations dashboard.
REAL_MING_DASHBOARD_TOKEN=

# Derive the Knowledge Vault encryption key and the audit pseudonym key.
REAL_MING_VAULT_KEY=

# Authenticate the Lenovo private worker to the control plane.
REAL_MING_WORKER_SHARED_SECRET=

# =============================================================================
# SECTION 2 · CONFIGURATION — not secret; release.env in production
# =============================================================================
# Nothing below is credential material except the optional provider tokens
# marked as such. In production these come from /etc/real-ming/release.env, and
# only the names the systemd unit passes with --env reach the container.
#
# ---------------------------------------------------------------------------
# NOTHING IN THIS SECTION NEEDS YOU TO GO AND FIND A VALUE.
# ---------------------------------------------------------------------------
# A blank here is not a to-do. It means "use the default", and every blank is
# annotated below with what that default is. Filling in none of them leaves the
# system behaving exactly as it does today. Section 1 is the only part that
# ever asks you for something, and it is complete.

# --- Revision 6 ownership switches ------------------------------------------
# These decide which process owns a shared resource. An unrecognised value
# refuses to start rather than defaulting, because a typo would silently create
# a second owner -- the one failure the migration exists to prevent.

# Which process holds the single Telegram consumer.
#   real-ming-ingress     Revision 5 behaviour: Real-Ming polls getUpdates.
#   native-hermes-gateway Revision 6: the native gateway polls; Real-Ming keeps
#                         its records, schedules and dashboard but polls nothing.
# The deployed host runs native-hermes-gateway. Telegram permits exactly one
# reliable poller, so changing this is a swap, never an addition.
REAL_MING_TELEGRAM_OWNERSHIP=native-hermes-gateway

# Which process triggers the 07:30 brief and 21:30 roll-up.
#   real-ming          Real-Ming's own scheduler fires and delivers them.
#   native-hermes-cron Native cron fires; Real-Ming still composes the content.
# Leave as real-ming until the native cron cutover is performed, or the brief
# either stops or arrives twice.
REAL_MING_SCHEDULER_OWNERSHIP=real-ming

# --- Hermes binding ---------------------------------------------------------
# Hermes owns its own Codex OAuth session. Real-Ming never receives or stores
# that token -- only the private API-server key below.
#
# Note for native mode: the composition still requires REAL_MING_HERMES_API_KEY
# whenever REAL_MING_HERMES_ENABLED is true, even though it no longer routes
# conversation through the API. The key is also what lets the MCP server call
# the native-cron report endpoint.
REAL_MING_HERMES_ENABLED=false
# Hermes API_SERVER gateway (8642 is Hermes's default; 9119 is its dashboard backend).
REAL_MING_HERMES_BASE_URL=http://127.0.0.1:8642
# blank -> a local run simply does not reach Hermes. Production resolves this
#          from Key Vault as `real-ming-hermes-api-key`, already provisioned.
REAL_MING_HERMES_API_KEY=
# ^ the one credential in this section; it belongs in the secret store.
REAL_MING_HERMES_MODEL=gpt-5.6-sol
REAL_MING_HERMES_PROVIDER=openai-codex
REAL_MING_HERMES_REASONING=medium
# Retained Revision 5 session mapping. Still backed up; no longer written to in
# native mode.
REAL_MING_HERMES_SESSIONS_PATH=/var/lib/real-ming/hermes.sqlite

# --- Native cron bridge · only when SCHEDULER_OWNERSHIP is native-hermes-cron
# When enabled, the Real-Ming MCP server exposes a tool that native cron calls
# to run a scheduled report. It authenticates with the Hermes API-server key
# above (or API_SERVER_KEY from the Hermes environment) and does nothing at all
# without one.
REAL_MING_NATIVE_CRON_ENABLED=false
REAL_MING_NATIVE_CRON_ENDPOINT=http://127.0.0.1:8787/internal/native-cron/run

# --- Storage and deployment paths · normally set by the systemd unit --------
REAL_MING_STATE_PATH=/var/lib/real-ming/state.sqlite
REAL_MING_NOTION_LEDGER_PATH=/var/lib/real-ming/notion-write-ledger.sqlite
REAL_MING_DASHBOARD_PORT=8787
# Resolve unset credentials from Azure Key Vault through the VM managed
# identity. Leave empty to require every value from the environment.
# blank -> every credential must come from this file. Correct for local work;
#          the systemd unit supplies the vault name in production.
REAL_MING_AZURE_KEY_VAULT_NAME=

# Backup inputs. The native Hermes stores are snapshotted into the Real-Ming
# volume by deploy/backup-control-plane.sh before the backup container runs.
REAL_MING_HERMES_STATE_PATH=/var/lib/hermes-real-ming/state.db
REAL_MING_HERMES_VAULT_PATH=/var/lib/real-ming/hermes-vault.snapshot
# blank -> the backup CLI writes to its default location.
REAL_MING_LOCAL_BACKUP_DIRECTORY=

# --- Optional integrations · none are needed for Revision 6 to work ---------

# Local CEO-facing Obsidian view written by the Real-Ming materializer. Keep it
# distinct from the native Obsidian vault Hermes writes, so one writer owns each
# path and a generated export never overwrites a hand-edited note.
# blank -> no Real-Ming Obsidian export is written. Milestone 6 decides whether
#          this is wanted alongside the native vault.
REAL_MING_OBSIDIAN_DIRECTORY=
REAL_MING_OBSIDIAN_ROOTS=CEO

# Calendar to reconcile. Unset falls back to the primary calendar, which is the
# deployed behaviour; the systemd unit does not pass this through.
# blank -> your primary calendar, which is the deployed behaviour.
REAL_MING_GOOGLE_CALENDAR_ID=

# --- Repository Center and deployment lineage (RM-25 / RM-26) ---------------
# These three are INERT on their own. They are consumed only while building
# Repository Center adapters, and that loop iterates the projects supplied by
# REAL_MING_PORTFOLIO_PROJECTS_JSON -- which is empty by default and is not
# passed into the container. Setting a token without portfolio records, and
# without a --env passthrough, changes nothing.
#
# They also feed the Real-Ming dashboard's Repository Center view, which
# milestone 7 may replace with a native dashboard extension. Provision them
# after that decision, not before.
#
# None of this is the path the agent uses to write code: under Revision 6 it
# edits and tests through native Hermes tools. Pushing a branch or opening a
# pull request would need a credential in the HERMES environment, which is a
# separate write-scoped decision.
# blank -> no portfolio records, which is why the two tokens below stay inert.
REAL_MING_PORTFOLIO_PROJECTS_JSON=
# blank -> Repository Center reports GitHub as unconfigured. Deferred to
#          milestone 7; see the note above.
REAL_MING_GITHUB_READ_TOKEN=
# blank -> deployment lineage reports Vercel as unconfigured. Same deferral.
REAL_MING_VERCEL_READ_TOKEN=

# Local checkout the Git lineage reader inspects. When absent the dashboard
# reports Git as unavailable rather than inferring worker state.
# blank -> the dashboard reports Git as unavailable rather than guessing.
REAL_MING_GIT_REPOSITORY_PATH=
# Optional per-project override, e.g. REAL_MING_DUITSINI_GIT_PATH.

# --- Email operations -------------------------------------------------------
# Supplied only after the CEO authorizes mailbox access. All three mailbox
# bindings are required together whenever the access token is present; the
# composition refuses to start with a partial set.
# The token and the read tokens above are credential material despite sitting
# in this section; keep them in the secret store, not in release.env.
# blank -> email operations stay off. Turning them on needs your own OAuth
#          consent, so this one would come back to you as a decision, not a lookup.
REAL_MING_GMAIL_ACCESS_TOKEN=
# blank -> unused while the token above is blank.
REAL_MING_PERSONAL_MAILBOX=
# blank -> unused while the token above is blank.
REAL_MING_OPPORTUNITY_MAILBOX=
# blank -> unused while the token above is blank.
REAL_MING_ENTERTAINMENT_MAILBOX=

# --- Testing ----------------------------------------------------------------
# Live provider smoke tests are opt-in and additionally require real supplied
# credentials. Default test runs must never contact a provider, spend quota or
# touch production data.
# blank -> live smoke tests skip, which is the required default. Set to 1 only
#          for a deliberate authorized live check.
REAL_MING_LIVE_SMOKE=
