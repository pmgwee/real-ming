# Real-Ming Tracer 1 configuration
#
# Copy to .env and supply each value from the authorized secret store.
# Never commit a filled-in copy; .env and .env.* are ignored by Git.
# Names only live here. Values live only in the secret store.

# Authenticate the private Telegram front door.
REAL_MING_TELEGRAM_BOT_TOKEN=

# Allowlist the single numeric Telegram identity that may command Real-Ming.
REAL_MING_TELEGRAM_CEO_ID=

# Read and write Master Tasks and the linked Work Views.
REAL_MING_NOTION_TOKEN=

# Identify the canonical Master Tasks data source.
REAL_MING_NOTION_MASTER_TASKS_ID=

# Identify the Google authorization client for Calendar.
REAL_MING_GOOGLE_CLIENT_ID=

# Authorize the Google Calendar client.
REAL_MING_GOOGLE_CLIENT_SECRET=

# Maintain delegated Calendar access without re-consent.
REAL_MING_GOOGLE_REFRESH_TOKEN=

# Authenticate the CEO to the operations dashboard.
REAL_MING_DASHBOARD_TOKEN=

# Derive the Knowledge Vault encryption key.
REAL_MING_VAULT_KEY=

# Authenticate the Lenovo private worker to the control plane.
REAL_MING_WORKER_SHARED_SECRET=

# Optional Phase 4 Hermes API-server binding. Hermes owns its Codex OAuth
# session; Real-Ming stores only this API-server key name/value in the Azure
# secret store and sends scoped turns through the private Hermes listener.
REAL_MING_HERMES_ENABLED=false
# Hermes API_SERVER gateway (8642 is Hermes's default; 9119 is its dashboard backend).
REAL_MING_HERMES_BASE_URL=http://127.0.0.1:8642
REAL_MING_HERMES_API_KEY=
REAL_MING_HERMES_MODEL=gpt-5.6-sol
REAL_MING_HERMES_PROVIDER=openai-codex
REAL_MING_HERMES_REASONING=medium
REAL_MING_HERMES_SESSIONS_PATH=/var/lib/real-ming/hermes.sqlite
# Optional backup input for Hermes's native persistent conversation database.
REAL_MING_HERMES_STATE_PATH=/var/lib/real-ming/hermes/state.db

# Optional local CEO-facing Obsidian view. Keep this outside synced/shared
# folders unless every Trust Domain projection has been intentionally reviewed.
REAL_MING_OBSIDIAN_DIRECTORY=
REAL_MING_OBSIDIAN_ROOTS=CEO

# Optional read-only GitHub API token for the Repository Center (RM-25).
# Leave empty to use the provider's unauthenticated read limits.
REAL_MING_GITHUB_READ_TOKEN=

# Optional read-only Vercel API token for deployment lineage (RM-26).
REAL_MING_VERCEL_READ_TOKEN=

# Optional local checkout path used by the Git lineage reader. When absent,
# the dashboard reports Git as unavailable rather than inferring worker state.
REAL_MING_GIT_REPOSITORY_PATH=

# Optional per-project override, e.g. REAL_MING_DUITSINI_GIT_PATH.
